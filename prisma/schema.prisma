generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ESTIMATOR
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  password     String
  role         Role       @default(ESTIMATOR)
  profileImage String?    @db.Text
  estimates    Estimate[]
  customers    Customer[]
  sessions     Session[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Customer {
  id              String     @id @default(cuid())
  title           String?
  name            String?
  surname         String?
  physicalAddress String?    @db.Text
  telephone       String?
  email           String?
  notes           String?    @db.Text // internal notes — never rendered on a quote
  pinned          Boolean    @default(false)
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  estimates       Estimate[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Estimate {
  id               String   @id @default(cuid())
  address          String
  customerName     String?
  customerPhone    String?
  latitude         Float
  longitude        Float
  footprintGeoJSON String   @db.Text
  footprintAreaM2  Float
  pitchDegrees     Float
  surfaceAreaM2    Float
  ratePerM2        Float?
  totalCost        Float?
  confidenceScore  Float?
  sourcesUsed      String
  notes               String?            @db.Text
  quoteNumber         String?            // stable, issued once at save (see D-quote-number)
  sentAt              DateTime?          // when the quote was first sent/downloaded
  opportunityStatus   OpportunityStatus  @default(OPEN)
  opportunityReason   String?            @db.Text
  opportunityUpdatedAt DateTime?
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id])
  userId              String
  user             User     @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  userId     String
  userName   String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PdfSettings {
  id                 String   @id @default("default")
  companyName        String   @default("Roofactor")
  companyTagline     String   @default("Professional Roof Coating Solutions")
  companyLogo        String?  @db.Text
  documentTitle      String   @default("QUOTATION")
  termsAndConditions String?  @db.Text
  footerText         String   @default("powered for Nomiplex 2026")
  quoteValidityDays  Int      @default(30)
  contactPhone       String?
  contactEmail       String?
  updatedAt          DateTime @updatedAt
}
